# Copy to `.env` for a standalone run. In the lab this file is rendered by
# Ansible from the encrypted vault (mode 0600) and never comes from here.
#
# Docker Compose reads it from the project directory; every value below is
# required unless the Compose file gives it a default.

# Port Caddy proxies to and the dashboard links to.
PUBLISH_PORT=8099
TZ=Etc/UTC

# Browsers sign in with the user/password; automation sends the token as
# `Authorization: Bearer <token>`. Both are hashed into the session key, so
# rotating either one logs every browser out.
#   openssl rand -hex 32
PANEL_USER=admin
PANEL_PASSWORD=
PANEL_TOKEN=

# llama.cpp's router, by its LAN address: inside the container 127.0.0.1 is the
# panel itself.
LLAMA_URL=http://192.168.10.26:8080
# Optional: comma-separated substrings of the model ids the dashboard may name.
# Empty lists everything the router serves.
LLAMA_PUBLIC_MODELS=

# Cards the node is supposed to have, so the dashboard can say that one is not
# initialising (the failure mode of the P100 after a kernel update). 0 = report
# what nvidia-smi answers without calling anything missing.
GPU_EXPECTED=2

# The Proxmox node: nvidia-smi, the power limit and `pct exec` into the AI
# container all start here.
PVE_HOST=root@pve.lan
# The Immich host, whose `immich_machine_learning`, redis queues and Postgres
# system config are read and driven.
IMMICH_HOST=root@immich.lan
# The frontend host, where Jellyfin's encoding.xml is rewritten.
FRONTEND_HOST=root@frontend.lan
JELLYFIN_XML=/opt/docker/jellyfin/config/encoding.xml
# Proxmox VM ID of the AI container (llama.cpp's logs live in its journald).
AI_CTID=126
LLAMA_LOG_UNIT=llama-server
# Where Jellyfin transcodes while llama.cpp owns the P100: vaapi (iGPU) or none.
JELLYFIN_FALLBACK=vaapi

# ComfyUI, reached over the LAN and driven through the AI container.
COMFY_URL=http://192.168.10.26:8188
COMFY_UI_URL=https://comfy.example.lan/
COMFY_CONTAINER=comfyui
