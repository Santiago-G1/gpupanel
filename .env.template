# Copy to `.env` for a standalone run. In the lab this file is rendered by
# Ansible from an encrypted vault (mode 0600) and never comes from here.
#
# Two variables are required — GPU_HOST and LLAMA_URL — plus the two
# credentials. Everything else is a consumer the panel drives only if you tell
# it where that consumer is; empty means "not configured", and the dashboard
# shows it that way instead of failing.

PUBLISH_PORT=8099
TZ=Etc/UTC

# --- required ---------------------------------------------------------------
# Any SSH target where `nvidia-smi` answers: a Proxmox node, a plain server, a
# workstation. The panel sets the power limit and reads the cards there.
GPU_HOST=root@gpu.lan
# The llama.cpp router (llama-swap, or llama.cpp in router mode), by its LAN
# address: inside the panel's container 127.0.0.1 is the panel itself.
LLAMA_URL=http://192.168.10.26:8080

# Browsers sign in with the user/password; automation sends the token as
# `Authorization: Bearer <token>`. Both are hashed into the session key, so
# rotating either one logs every browser out.
#   openssl rand -hex 32
PANEL_USER=admin
PANEL_PASSWORD=
PANEL_TOKEN=

# --- llama.cpp and ComfyUI: where they run ----------------------------------
# Defaults to GPU_HOST. Set it when the model server lives elsewhere, and set
# AI_CTID when it runs inside a Proxmox container on that host (`pct exec`).
AI_HOST=
AI_CTID=
LLAMA_LOG_UNIT=llama-server
# Optional: comma-separated substrings of the model ids the dashboard may name.
# Empty lists everything the router serves.
LLAMA_PUBLIC_MODELS=
# Cards the node is supposed to have, so the dashboard can say that one is not
# initialising. 0 = report what nvidia-smi answers without judging.
GPU_EXPECTED=2

# --- Immich (optional) ------------------------------------------------------
# Its container names belong to Immich and have changed between releases.
IMMICH_HOST=
IMMICH_ML_CONTAINER=immich_machine_learning
IMMICH_PG_CONTAINER=immich_postgres
IMMICH_REDIS_CONTAINER=immich_redis
IMMICH_QUEUE_PREFIX=immich_bull
# Queues that mean somebody is waiting for the ML container.
IMMICH_ML_QUEUES=faceDetection,smartSearch,ocr

# --- Jellyfin (optional) ----------------------------------------------------
# The host and the config file it rewrites, or the panel leaves it alone.
JELLYFIN_HOST=
JELLYFIN_XML=
JELLYFIN_CONTAINER=jellyfin
# Where Jellyfin transcodes while llama.cpp owns the card: vaapi (integrated
# GPU, keeps hardware transcoding) or none (CPU).
JELLYFIN_FALLBACK=vaapi

# --- ComfyUI (optional) -----------------------------------------------------
# COMFY_CONTAINER enables start/stop; COMFY_URL only adds the queue depth and
# the VRAM it sees free.
COMFY_CONTAINER=
COMFY_URL=
COMFY_UI_URL=
