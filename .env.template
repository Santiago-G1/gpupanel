# Copy to `.env` for a standalone run. In the lab this file is rendered by
# Ansible from an encrypted vault (mode 0600) and never comes from here.
#
# Two variables are required — GPU_HOST and LLAMA_URL — plus the two
# credentials. Everything else is a consumer the panel drives only if you tell
# it where that consumer is; empty means "not configured", and the dashboard
# shows it that way instead of failing.

PUBLISH_PORT=8099
# Where the port is published. 127.0.0.1 keeps the panel off the LAN, which is
# what a reverse proxy on the same host wants; a proxy on another host needs
# this address plus a firewall rule. 0.0.0.0 puts it on every interface.
PUBLISH_ADDR=0.0.0.0
TZ=Etc/UTC

# --- required ---------------------------------------------------------------
# Any SSH target that can be read: a Proxmox node, a plain server, a
# workstation. The cards come from /sys/class/drm (any vendor) plus nvidia-smi
# for NVIDIA ones. The power limit goes through the vendor's tool when it is
# installed, and through hwmon (power1_cap) for any card that exposes it.
GPU_HOST=root@gpu.lan
# The llama.cpp router (llama-swap, or llama.cpp in router mode), by its LAN
# address: inside the panel's container 127.0.0.1 is the panel itself.
LLAMA_URL=http://llama.lan:8080
# Only if the router was started with `--api-key` (or a proxy in front wants
# one): it is sent as `Authorization: Bearer`. Empty sends nothing.
LLAMA_API_KEY=

# Browsers sign in with the user/password; automation sends the token as
# `Authorization: Bearer <token>`. Both are hashed into the session key, so
# rotating either one logs every browser out.
#   openssl rand -hex 32
PANEL_USER=admin
PANEL_PASSWORD=
PANEL_TOKEN=

# The session cookie and the login throttle. Defaults shown.
SESSION_COOKIE=panel_session
SESSION_TTL=604800
LOGIN_DELAY=0.4
LOGIN_MAX_FAILURES=5
LOGIN_WINDOW=300
# Addresses whose X-Forwarded-For is believed, comma separated: the reverse
# proxy in front of the panel. Empty means none, and then the header is ignored
# because any client can write it.
TRUSTED_PROXIES=
# Inside the container; the Compose file bind-mounts ./state there.
STATE_PATH=/state/auto.json

# --- llama.cpp and ComfyUI: where they run ----------------------------------
# Defaults to GPU_HOST. Set it when the model server lives elsewhere, and set
# AI_CTID when it runs inside a Proxmox container on that host (`pct exec`).
AI_HOST=
AI_CTID=
LLAMA_LOG_UNIT=llama-server
# The folder the models live in, as llama.cpp sees it (inside AI_CTID when there
# is one). Empty means the panel never reads the disk.
LLAMA_MODELS_DIR=
# Optional: comma-separated substrings of the model ids the dashboard may name.
# Empty lists everything the router serves.
LLAMA_PUBLIC_MODELS=
# Cards the node is supposed to have, so the dashboard can say that one is not
# initialising. 0 = report what the probe answers without judging.
GPU_EXPECTED=0
# The exact set, when a count is not enough: PCI addresses or UUIDs, comma
# separated. Empty means the count above is all the panel knows.
GPU_EXPECTED_IDS=
# Kernel lines (NVRM, Xid, AER) from around a change are attached to the event
# that records it. 0 turns the extra SSH off.
GPU_EVIDENCE=1

# --- Immich (optional) ------------------------------------------------------
# Its container names belong to Immich and have changed between releases.
IMMICH_HOST=
IMMICH_ML_CONTAINER=immich_machine_learning
IMMICH_PG_CONTAINER=immich_postgres
IMMICH_REDIS_CONTAINER=immich_redis
IMMICH_QUEUE_PREFIX=immich_bull
# Queues that mean somebody is waiting for the ML container.
IMMICH_ML_QUEUES=faceDetection,smartSearch,ocr

# --- Jellyfin (optional) ----------------------------------------------------
# The host and the config file it rewrites, or the panel leaves it alone.
JELLYFIN_HOST=
JELLYFIN_XML=
JELLYFIN_CONTAINER=jellyfin
# Jellyfin's own acceleration values, both of them: none, amf, qsv, nvenc,
# v4l2m2m, vaapi, videotoolbox, rkmpp. Anything else stops the panel at start
# instead of being silently replaced by a default.
# Where Jellyfin transcodes while llama.cpp owns the card.
JELLYFIN_FALLBACK=vaapi
# Where it goes back to when the card is free again: the card's own encoder.
JELLYFIN_ACCEL_GPU=nvenc

# --- ComfyUI (optional) -----------------------------------------------------
# COMFY_CONTAINER enables start/stop; COMFY_URL only adds the queue depth and
# the VRAM it sees free.
COMFY_CONTAINER=
COMFY_URL=
COMFY_UI_URL=

# Where the SSH key that reaches the hosts lives on the machine running this
# container. Mounted at /root/.ssh, read only.
SSH_PATH=/root/.ssh
