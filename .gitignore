# CREDENTIALS AND SECRETS
.env
.env.*
**/.env
*.pem
*.key
*secret*
*password*

# Versionable templates (never a real secret)
!.env.template

# RUNTIME STATE
# `./state` is the bind mount the container writes into, so it is here too: the
# settings and the revoked nonces are not the repository's. The probe file the
# startup check writes and removes is covered by the same name.
state/
auto.json
auto.json.probe

# PYTHON
__pycache__/
*.pyo
*.pyc
.venv/
venv/

# SYSTEM
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.vscode/
.idea/

# LOGS AND TEMPORARIES
*.log
*.tmp
*.bak
